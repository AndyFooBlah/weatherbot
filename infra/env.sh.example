#!/usr/bin/env bash
# Source this from your shell before running infra/*.sh:
#   source infra/env.sh
#
# Copy to env.sh and review. env.sh is gitignored.

# --- GCP ---
export PROJECT_ID="your-project-id"
export REGION="us-central1"
export ZONE="us-central1-a"

# --- Cloud SQL ---
export SQL_INSTANCE="weatherbot-db"
export SQL_DB_NAME="weatherbot"
export SQL_DB_USER="weatherbot_app"
# Smallest shared-core Postgres tier. Bump to db-custom-1-3840 (Enterprise) if needed.
export SQL_TIER="db-g1-small"
export SQL_VERSION="POSTGRES_16"
export CONNECTION_NAME="${PROJECT_ID}:${REGION}:${SQL_INSTANCE}"

# --- Secret Manager names ---
export SECRET_DB_PASSWORD="weatherbot-db-password"
export SECRET_AWN_API_KEY="weatherbot-awn-api-key"
export SECRET_AWN_APP_KEY="weatherbot-awn-app-key"

# --- Weather station ---
# Replace with your station's MAC address (Devices → click your station on
# ambientweather.net). Earliest backfill date is whatever your AWN dashboard
# shows as the first observation.
export STATION_MAC="XX:XX:XX:XX:XX:XX"
export STATION_BACKFILL_FROM="2024-01-01"

# --- QueryData context set ---
# Full resource name of the uploaded Conversational Analytics context set.
# Format:
#   projects/${PROJECT_ID}/locations/${REGION}/contextSets/<id>
# Source JSON lives at agent/context-sets/weatherbot-narrow.json; upload it
# via Cloud SQL Studio → Data Agents → Context Sets, then paste the
# returned resource name here. Empty string is fine until the upload is
# done — the ask_data tool will then run without authored context (the
# 'pool' vs 'Pool' case-sensitivity bug will remain until populated).
export WEATHERBOT_GDA_CONTEXT_SET_ID=""

# --- Daily outage report (weatherbot outage-report --send) ---
# The Gmail account that sends the report, and where it goes. See
# docs/gmail-report-setup.md for the one-time OAuth setup that creates the
# three weatherbot-gmail-* secrets referenced by 06-deploy-report-job.sh.
export REPORT_FROM_EMAIL="your-sender@gmail.com"
export REPORT_TO_EMAIL="you@gmail.com"
# Secret Manager names for the Gmail OAuth credentials (defaults shown;
# override only if you named them differently).
export SECRET_GMAIL_CLIENT_ID="weatherbot-gmail-client-id"
export SECRET_GMAIL_CLIENT_SECRET="weatherbot-gmail-client-secret"
export SECRET_GMAIL_REFRESH_TOKEN="weatherbot-gmail-refresh-token"
