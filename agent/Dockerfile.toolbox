# MCP Toolbox container — runs as the Cloud Run service `weatherbot-toolbox`.
# Built and pushed by infra/05-deploy-toolbox.sh, which uses a temp build
# context containing this file (renamed to Dockerfile) and toolbox.yaml.
#
# The toolbox binary is a statically linked Go program; the final image is
# distroless. All credentials (DB password) come in via Cloud Run env vars
# and Secret Manager — nothing baked into the image.

FROM debian:bookworm-slim AS fetch
ARG TOOLBOX_VERSION=1.3.0
# SHA-256 of the linux/amd64 binary for TOOLBOX_VERSION — update both together.
ARG TOOLBOX_SHA256=08e00671737ff4fd6c7af25a1a0c5da43b3657c4a435fd0a381757876d694b45
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fL --proto '=https' --tlsv1.2 \
      -o /toolbox \
      "https://storage.googleapis.com/mcp-toolbox-for-databases/v${TOOLBOX_VERSION}/linux/amd64/toolbox" \
 && echo "${TOOLBOX_SHA256}  /toolbox" | sha256sum -c - \
 && chmod +x /toolbox

FROM gcr.io/distroless/cc-debian12

COPY --from=fetch /toolbox /toolbox
COPY toolbox.yaml /toolbox.yaml

EXPOSE 5000

ENTRYPOINT ["/toolbox", \
            "--config", "/toolbox.yaml", \
            "--address", "0.0.0.0", \
            "--port", "5000", \
            "--logging-format", "JSON", \
            "--telemetry-gcp"]
